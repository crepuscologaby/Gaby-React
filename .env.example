# Questo file è un ESEMPIO: mostra quali variabili servono, ma senza i valori veri.
# Su Supabase.com trovi questi valori dentro: Project Settings > API
#
# COME USARLO:
# 1) copia questo file e rinominalo ".env" (senza .example)
# 2) incolla i tuoi valori veri al posto di quelli finti qui sotto
# 3) NON caricare mai il file ".env" vero su GitHub (contiene dati sensibili)
#    -> per questo è già escluso nel file .gitignore

VITE_SUPABASE_URL=https://tuoprogetto.supabase.co
VITE_SUPABASE_ANON_KEY=la-tua-chiave-anon-pubblica

# La chiave API di Anthropic va SOLO sul backend (mai qui, mai nel frontend!)
# la aggiungeremo più avanti quando costruiamo la sezione AI
